# ===========================================
# 企业评分分析系统 — 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ===========================================

APP_NAME=app_v2.2
ENVIRONMENT=local

# 数据库 — PostgreSQL (Docker) 或 SQLite (本地回退)
# Docker: postgresql+asyncpg://app_v2:app_v2@localhost:5432/app_v2
# SQLite: sqlite+aiosqlite:///./test_local.db
DATABASE_URL=postgresql+asyncpg://app_v2:app_v2@localhost:5432/app_v2

# Redis (Docker 环境必填，本地 SQLite 模式可忽略)
REDIS_URL=redis://localhost:6379/0

# JWT 认证 — 生产环境务必使用强随机字符串
JWT_SECRET_KEY=your-jwt-secret-here-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# LLM 配置 — 使用你的 API 密钥
OPENAI_API_KEY=sk-your-api-key-here
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o
LLM_MODEL=gpt-4o
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
